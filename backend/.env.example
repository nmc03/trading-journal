# Copia este archivo como .env y sustituye todos los valores de ejemplo.
TJ_USER=admin
TJ_PASSWORD=cambia-esta-contrasena-segura

# Genera un secreto con: openssl rand -base64 48
JWT_SECRET=genera-una-clave-aleatoria-larga-aqui

PORT=3001

# Proxies de confianza delante de la app (0 = acceso directo).
# Pon 1 solo si la sirves detrás de un reverse proxy HTTPS (Caddy, Traefik, nginx...).
TRUST_PROXY_HOPS=0

# Opcional: solo si otro frontend accede a la API desde un origen distinto.
# CORS_ORIGIN=https://journal.example.com
